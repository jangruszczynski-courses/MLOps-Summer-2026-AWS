# Triton model configuration for the image classifier.
#
# max_batch_size: 0  →  dynamic batching is fully disabled.
# When batching is disabled the dims arrays must include every
# dimension of the tensor, including the (fixed) batch axis.

name: "image_classifier"
backend: "onnxruntime"

# Disable batching – each request carries exactly one image.
max_batch_size: 0

input [
  {
    name:      "input"
    data_type: TYPE_FP32
    # [batch, channels, height, width]  –  batch is always 1
    dims:      [ 1, 3, 224, 224 ]
  }
]

output [
  {
    name:      "output"
    data_type: TYPE_FP32
    # [batch, num_classes]  –  1000 ImageNet classes
    dims:      [ 1, 1000 ]
  }
]


